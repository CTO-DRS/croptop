# GPU develop compute: the headless Vulkan helper and the SPIR-V develop shaders, built into croptop_engine_core
# when a shader compiler and Vulkan headers are available (always on Android via the NDK; on a host when `glslc` and Vulkan are found).
# Sets CROPTOP_GPU_DEVELOP to ON/OFF for the parent scope; without it the engine simply has no GPU develop path (CPU reference only).
set(CROPTOP_GPU_DEVELOP OFF)
if(ANDROID)
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        set(_gpu_hint "${CMAKE_ANDROID_NDK}/shader-tools/linux-x86_64")
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
        set(_gpu_hint "${CMAKE_ANDROID_NDK}/shader-tools/darwin-x86_64")
    else()
        set(_gpu_hint "${CMAKE_ANDROID_NDK}/shader-tools/windows-x86_64")
    endif()
else()
    set(_gpu_hint "")
endif()
find_program(CROPTOP_GLSLC NAMES glslc HINTS "${_gpu_hint}")
find_program(CROPTOP_SPIRV_VAL NAMES spirv-val HINTS "${_gpu_hint}")
if(NOT ANDROID)
    find_package(Vulkan QUIET)
endif()
if(CROPTOP_GLSLC AND (ANDROID OR Vulkan_FOUND))
    set(CROPTOP_GPU_DEVELOP ON)
    set(_gpu_gen "${CMAKE_CURRENT_BINARY_DIR}/generated")
    file(MAKE_DIRECTORY "${_gpu_gen}")
    set(_gpu_headers "")
    set(_gpu_shaders develop_color develop_tone histogram)
    if(NOT ANDROID)
        # Host only: the compositor's blend shader is generated by the Android block of the parent CMakeLists there. Building it here lets
        # the blend parity test (native_tests_vulkan_blend) run against the CPU reference on any Vulkan host.
        list(APPEND _gpu_shaders blend)
    endif()
    foreach(_shader IN LISTS _gpu_shaders)
        set(_spv "${_gpu_gen}/${_shader}.comp.spv")
        set(_hdr "${_gpu_gen}/${_shader}_comp_spv.h")
        string(REPLACE "_" ";" _parts "${_shader}")
        set(_symbol "k")
        foreach(_p IN LISTS _parts)
            string(SUBSTRING "${_p}" 0 1 _first)
            string(TOUPPER "${_first}" _first)
            string(SUBSTRING "${_p}" 1 -1 _rest)
            string(APPEND _symbol "${_first}${_rest}")
        endforeach()
        string(APPEND _symbol "ShaderSpirv")  # develop_color -> kDevelopColorShaderSpirv
        set(_validate "")
        if(CROPTOP_SPIRV_VAL)
            set(_validate COMMAND "${CROPTOP_SPIRV_VAL}" --target-env vulkan1.1 "${_spv}")
        endif()
        add_custom_command(OUTPUT "${_spv}"
            COMMAND "${CROPTOP_GLSLC}" --target-env=vulkan1.1 -Werror -o "${_spv}" "${CMAKE_CURRENT_SOURCE_DIR}/shaders/${_shader}.comp"
            ${_validate}
            DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/shaders/${_shader}.comp"
            VERBATIM)
        add_custom_command(OUTPUT "${_hdr}"
            COMMAND "${CMAKE_COMMAND}" "-DINPUT=${_spv}" "-DOUTPUT=${_hdr}" "-DSYMBOL=${_symbol}"
                -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/embed_spirv.cmake"
            DEPENDS "${_spv}" "${CMAKE_CURRENT_SOURCE_DIR}/cmake/embed_spirv.cmake"
            VERBATIM)
        list(APPEND _gpu_headers "${_hdr}")
    endforeach()
    add_custom_target(croptop_gpu_shaders DEPENDS ${_gpu_headers})
    add_dependencies(croptop_engine_core croptop_gpu_shaders)
    target_sources(croptop_engine_core PRIVATE gpu_compute.cpp develop_color_gpu.cpp develop_tone_gpu.cpp develop_gpu.cpp histogram_gpu.cpp gpu_service.cpp)
    target_include_directories(croptop_engine_core PRIVATE "${_gpu_gen}")
    target_compile_definitions(croptop_engine_core PUBLIC CROPTOP_HAS_GPU_DEVELOP=1)
    if(NOT ANDROID)
        target_sources(croptop_engine_core PRIVATE vulkan_blend_pipeline.cpp)
    endif()
    if(ANDROID)
        target_link_libraries(croptop_engine_core PUBLIC vulkan)
    else()
        target_link_libraries(croptop_engine_core PUBLIC Vulkan::Vulkan)
    endif()
endif()
