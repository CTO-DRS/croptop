if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "INPUT and OUTPUT are required")
endif()
if(NOT DEFINED SYMBOL)
    set(SYMBOL kBlendShaderSpirv)  # the blend shader's historical name
endif()
file(READ "${INPUT}" SPIRV_HEX HEX)
string(LENGTH "${SPIRV_HEX}" SPIRV_HEX_LENGTH)
math(EXPR REMAINDER "${SPIRV_HEX_LENGTH} % 8")
if(NOT REMAINDER EQUAL 0)
    message(FATAL_ERROR "SPIR-V byte count is not divisible by four")
endif()
math(EXPR WORD_COUNT "${SPIRV_HEX_LENGTH} / 8")
set(HEADER "#pragma once\n#include <cstdint>\nnamespace croptop {\nalignas(4) inline constexpr std::uint32_t ${SYMBOL}[] = {\n")
foreach(INDEX RANGE 0 ${WORD_COUNT})
    if(INDEX LESS WORD_COUNT)
        math(EXPR OFFSET "${INDEX} * 8")
        string(SUBSTRING "${SPIRV_HEX}" ${OFFSET} 2 B0)
        math(EXPR OFFSET1 "${OFFSET} + 2")
        math(EXPR OFFSET2 "${OFFSET} + 4")
        math(EXPR OFFSET3 "${OFFSET} + 6")
        string(SUBSTRING "${SPIRV_HEX}" ${OFFSET1} 2 B1)
        string(SUBSTRING "${SPIRV_HEX}" ${OFFSET2} 2 B2)
        string(SUBSTRING "${SPIRV_HEX}" ${OFFSET3} 2 B3)
        string(APPEND HEADER "0x${B3}${B2}${B1}${B0}u,\n")
    endif()
endforeach()
string(APPEND HEADER "};\ninline constexpr std::uint32_t ${SYMBOL}Bytes = sizeof(${SYMBOL});\n}\n")
file(WRITE "${OUTPUT}" "${HEADER}")
