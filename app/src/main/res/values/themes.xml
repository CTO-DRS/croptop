<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches bg/app so a resize or cold start never flashes white. -->
    <style name="Theme.CropTop" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ae_app_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
